# ContractOS production environment — copy to docker-compose.prod.env and fill in.
#
#   cp docker-compose.prod.env.example docker-compose.prod.env
#   openssl rand -hex 32   # generate each secret below
#
# docker-compose.prod.env is git-ignored; never commit real secrets.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=contractos
POSTGRES_DB=contractos
POSTGRES_PASSWORD=

# --- Application secrets (32+ random chars each) ----------------------------
JWT_SECRET_KEY=
FIELD_ENCRYPTION_MASTER_KEY=
EMAIL_OPT_OUT_TOKEN=
DOCUMENT_TOKEN_SECRET=

# --- Public URLs ------------------------------------------------------------
APP_BASE_URL=https://app.contractos.lk
CORS_ORIGINS=https://app.contractos.lk

# --- Email / CAN-SPAM -------------------------------------------------------
EMAIL_FROM_ADDRESS=noreply@contractos.lk
EMAIL_FROM_NAME=ContractOS
EMAIL_POSTAL_ADDRESS=ContractOS (Pvt) Ltd, 121 Galle Road, Colombo 03, Sri Lanka
SENDGRID_API_KEY=

# --- Providers (stubs are refused in production) ----------------------------
ESIGNATURE_PROVIDER=docusign
KYC_PROVIDER=stripe_identity
EMBEDDING_PROVIDER=openai
# Leave blank for the implicit AWS Textract -> Google Document AI chain.
OCR_PROVIDER=

# --- Object storage (required in production) --------------------------------
STORAGE_BACKEND=s3
S3_BUCKET=contractos-documents
S3_REGION_NAME=us-east-1
# Set for MinIO / S3-compatible endpoints; leave blank for AWS.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Reverse proxy ----------------------------------------------------------
# Number of trusted proxy hops; keep the default when exactly one TLS proxy
# (load balancer / ingress) sits in front of the app.
FORWARDED_HOP_COUNT=1

# Host port the frontend publishes (change to run staging and production on
# the same host).
FRONTEND_PORT=3000
