APP_NAME=ContractOS
ENVIRONMENT=development

# Public origin of this deployment. Verification and signing links are built
# from it, so a wrong value sends real emails into the void. Required, and
# must be https and non-localhost, when ENVIRONMENT=production.
APP_BASE_URL=http://localhost:3000

# Comma-separated browser origins allowed to call the API. Empty blocks every
# browser request; '*' is rejected in production because it is invalid
# alongside credentialed requests.
CORS_ORIGINS=http://localhost:3000

# Host header allowlist. Empty falls back to the App Base URL host.
# ALLOWED_HOSTS=

# /docs and /redoc enumerate every route and schema — a complete attack
# surface map. Off by default; production treats enabling it as an error.
EXPOSE_API_DOCS=false

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

# Per-process connection pool. Every API replica and Celery worker opens its
# own, so keep (DB_POOL_SIZE + DB_MAX_OVERFLOW) x replicas + workers below the
# server's max_connections — exhausting connections takes the whole instance
# down, not just the process that asked for too much.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Seconds a request waits for a free connection before failing.
DB_POOL_TIMEOUT_SECONDS=30

JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Document object storage (spec 1.23 / 2.07).
# 'local' keeps files on the container filesystem, where they are lost on
# every redeploy and on any replica that starts fresh — production refuses it.
STORAGE_BACKEND=local
DOCUMENT_STORAGE_DIR=storage/documents
# Required when STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION_NAME=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Secret used to sign secure download tokens (set a long random value in prod)
DOCUMENT_TOKEN_SECRET=change-me-generate-a-long-random-secret
# Download token lifetime in seconds (default 900)
DOCUMENT_DOWNLOAD_TOKEN_TTL=900

# E-signature provider: mock | docusign | adobe_sign (spec 24.5)
ESIGNATURE_PROVIDER=mock

# KYC / identity verification (spec 24.4): 'mock' | 'stripe_identity'.
# Governs guest ID verification when a party requires full document checks.
KYC_PROVIDER=mock
# Required when KYC_PROVIDER=stripe_identity
STRIPE_IDENTITY_API_KEY=
# Verifies Stripe Identity webhook callbacks (identity.verification_session.*)
STRIPE_IDENTITY_WEBHOOK_SECRET=
# Required when ESIGNATURE_PROVIDER=docusign
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY_PATH=keys/docusign_private.pem
DOCUSIGN_OAUTH_BASE_URL=account-d.docusign.com
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_WEBHOOK_SECRET=
# Callback base URL DocuSign redirects to after an envelope is signed.
ESIGN_CALLBACK_BASE_URL=APP_BASE_URL

# Required when ESIGNATURE_PROVIDER=adobe_sign
ADOBESIGN_ACCESS_TOKEN=
ADOBESIGN_BASE_URL=https://api.echosign.com/api/rest/v6
ADOBESIGN_LIBRARY_ID=
ADOBE_WEBHOOK_SECRET=

# AI contract intelligence (spec 17/18/36). Leave OPENAI_API_KEY empty to use
# the built-in rule-based extractor; set it to enable LLM analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_PROVIDER=openai

# Long-contract analysis (spec 1.19.24): contracts longer than AI_CHUNK_CHARS
# are analyzed in overlapping chunks and merged, so the model reads the whole
# agreement instead of silently seeing only the first page. 0 = one request.
AI_CHUNK_CHARS=60000
AI_CHUNK_OVERLAP_CHARS=800
AI_MAX_CHUNKS_PER_ANALYSIS=20

# Distributed state (spec 1.14.21-22). Set to share DLP sliding windows,
# escalation throttles/incidents and WebSocket fanout across API replicas and
# the Celery worker.
#
# Also backs API rate limiting and is the Celery broker. Unset, limits are
# enforced per-process — N replicas grant N times the intended budget — and
# background reminders never run. Production refuses to start without it;
# /health/ready reports 503 if it is configured but not answering.
# REDIS_URL=redis://localhost:6379/0

# Transactional email. EMAIL_POSTAL_ADDRESS appears in every outbound footer
# and CAN-SPAM requires the real sender's postal address there.
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=ContractOS
EMAIL_POSTAL_ADDRESS=
SENDGRID_API_KEY=

# Monitoring: which integrations are due, and the sweep that finds them.
# MONITORING_DEFAULT_TIMEOUT_SECONDS=300
# MONITORING_SWEEP_BATCH_SIZE=500
# Authenticates callbacks from monitoring webhooks; rejects replays older than
# MONITORING_WEBHOOK_MAX_SKEW_SECONDS.
# MONITORING_WEBHOOK_SECRET=
# MONITORING_WEBHOOK_MAX_SKEW_SECONDS=300

# OIDC login. The state nonce is single-use and TTL-bounded to blunt replay.
OIDC_STATE_TTL_SECONDS=600
OIDC_HTTP_TIMEOUT_SECONDS=10

# SMS delivery for obligation reminders. Leave unset to disable SMS channel.
# SMS_API_BASE_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=
# SMS_TIMEOUT_SECONDS=10

# Alternative LLM provider; ANTHROPIC_API_KEY is read when AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=

# Default reporting currency; FX_RATES_JSON carries the static rate table used
# when no rate provider is configured.
DEFAULT_CURRENCY=USD
# FX_RATES_JSON=

# Secret signing one-click email opt-out links. Read straight from the
# environment (not Settings), so it is documented here rather than defaulted.
# EMAIL_OPT_OUT_TOKEN=

# --- Secrets read directly from the environment -----------------------------
# These are not Settings fields; they are checked at startup in production.
# 32+ random characters each. Rotating FIELD_ENCRYPTION_MASTER_KEY makes
# existing encrypted PII unreadable, so back it up separately from the JWT
# secret.
# FIELD_ENCRYPTION_MASTER_KEY=

# FCM service-account JSON for web push notifications.
# FCM_CREDENTIALS_JSON=

# Document text extraction. 'mock' simulates extraction and is rejected in
# production.
OCR_PROVIDER=mock
OCR_CONFIDENCE_THRESHOLD=0.8
# Provider tried when OCR_PROVIDER returns nothing usable.
OCR_FALLBACK_PROVIDER=

# Operational alerting (incident notifications, not a data store).
ALERTING_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=
PAGERDUTY_ROUTING_KEY=
PAGERDUTY_FROM_EMAIL=

# Local pg_dump backups. Off by default; these only help if a volume outlives
# the container, which the S3 settings above are the real answer for.
BACKUP_ENABLED=false
BACKUP_DIR=backups
BACKUP_RETENTION_COUNT=7

# OpenTelemetry traces (optional; no exporter configured means sampling is moot).
TRACING_ENABLED=false
TRACING_OTLP_ENDPOINT=
TRACING_SERVICE_NAME=contractos-api
TRACING_SAMPLE_RATIO=0.1

# External timestamp authority (spec 1.20.16). When TSA_URL is set, audit
# batches are anchored with an RFC 3161 token from that TSA (e.g. a local
# FreeTSA or a commercial TSA like DigiCert/Sectigo); the token is stored on
# the batch and can be verified offline:
#   openssl ts -verify -token_in -data root.bin -CAfile tsa-chain.pem
# Unset = batches seal with the Merkle root only (anchor_status=internal_only).
# TSA_URL=https://freetsa.org/tsr
# TSA_USERNAME=
# TSA_PASSWORD=
# TSA_POLICY_OID=
# TSA_REQUEST_CERTIFICATE=false
# TSA_TIMEOUT_SECONDS=10

# Embeddings for knowledge retrieval (spec 2.10.3-2.10.6). 'openai' requires
# OPENAI_API_KEY (reuses the key above) and fails closed when unavailable;
# 'hash' is the deterministic local fallback (dev/test). EMBEDDING_DIM must
# match the pgvector column (1536).
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
