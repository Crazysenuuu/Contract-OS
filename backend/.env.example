APP_NAME=ContractOS
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:3000

# Document object storage (spec 1.23 / 2.07)
DOCUMENT_STORAGE_DIR=storage/documents
# Secret used to sign secure download tokens (set a long random value in prod)
DOCUMENT_TOKEN_SECRET=change-me-generate-a-long-random-secret
# Download token lifetime in seconds (default 900)
DOCUMENT_DOWNLOAD_TOKEN_TTL=900

# E-signature provider: mock | docusign | adobe_sign (spec 24.5)
ESIGNATURE_PROVIDER=mock

# KYC / identity verification (spec 24.4): 'mock' | 'stripe_identity'.
# Governs guest ID verification when a party requires full document checks.
KYC_PROVIDER=mock
# Required when KYC_PROVIDER=stripe_identity
STRIPE_IDENTITY_API_KEY=
# Verifies Stripe Identity webhook callbacks (identity.verification_session.*)
STRIPE_IDENTITY_WEBHOOK_SECRET=
# Required when ESIGNATURE_PROVIDER=docusign
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY_PATH=keys/docusign_private.pem
DOCUSIGN_OAUTH_BASE_URL=account-d.docusign.com
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi

# Required when ESIGNATURE_PROVIDER=adobe_sign
ADOBESIGN_ACCESS_TOKEN=
ADOBESIGN_BASE_URL=https://api.echosign.com/api/rest/v6

# AI contract intelligence (spec 17/18/36). Leave OPENAI_API_KEY empty to use
# the built-in rule-based extractor; set it to enable LLM analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_PROVIDER=openai

# Long-contract analysis (spec 1.19.24): contracts longer than AI_CHUNK_CHARS
# are analyzed in overlapping chunks and merged, so the model reads the whole
# agreement instead of silently seeing only the first page. 0 = one request.
AI_CHUNK_CHARS=60000
AI_CHUNK_OVERLAP_CHARS=800
AI_MAX_CHUNKS_PER_ANALYSIS=20

# Distributed state (spec 1.14.21-22). Set to share DLP sliding windows,
# escalation throttles/incidents and WebSocket fanout across API replicas and
# the Celery worker. Unset = in-process state (single-instance deployments).
# REDIS_URL=redis://localhost:6379/0

# External timestamp authority (spec 1.20.16). When TSA_URL is set, audit
# batches are anchored with an RFC 3161 token from that TSA (e.g. a local
# FreeTSA or a commercial TSA like DigiCert/Sectigo); the token is stored on
# the batch and can be verified offline:
#   openssl ts -verify -token_in -data root.bin -CAfile tsa-chain.pem
# Unset = batches seal with the Merkle root only (anchor_status=internal_only).
# TSA_URL=https://freetsa.org/tsr
# TSA_USERNAME=
# TSA_PASSWORD=
# TSA_POLICY_OID=
# TSA_REQUEST_CERTIFICATE=false
# TSA_TIMEOUT_SECONDS=10

# Embeddings for knowledge retrieval (spec 2.10.3-2.10.6). 'openai' requires
# OPENAI_API_KEY (reuses the key above) and fails closed when unavailable;
# 'hash' is the deterministic local fallback (dev/test). EMBEDDING_DIM must
# match the pgvector column (1536).
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
